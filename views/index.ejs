<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title  %></title>
</head>
<body>
    <% messages.forEach((message) => { %>
        <li>
            <h2>
                <%= message.user %> 
            </h2> <p> at <%= message.added %></p> 
             <p>message : <%= message.text  %></p>
        </li>
     <% }); %>
</body>
</html>